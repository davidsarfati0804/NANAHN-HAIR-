# Copier ce fichier en .env.local et remplir les valeurs (jamais dans Git).
# Générer les trois valeurs ADMIN_* avec : npm run admin:setup -- "mot de passe"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_TOTP_SECRET=

# Paiement Stripe (voir GUIDE.md) : clé de TEST d'abord (sk_test_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Emails par Gmail (mot de passe d'application Google, voir GUIDE.md)
SMTP_USER=
SMTP_PASSWORD=
# MAIL_NOTIFY=

# Production uniquement : adresse définitive et indexation Google
# SITE_URL=https://www.nanahnhair.com
# NNH_INDEXABLE=1
